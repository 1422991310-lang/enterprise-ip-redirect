{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enterprise-ip-redirect",
  "main": "src/index.js",
  "compatibility_date": "2026-05-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_IPS": "203.0.113.10,198.51.100.20",
    "TARGET_ALLOWED": "https://a.example.com/internal-page",
    "TARGET_FALLBACK": "https://c.example.com/access-info",
    "DEBUG_VIEW": "1"
  }
  // For production on your own B domain, add a route after replacing example.com:
  // "route": {
  //   "pattern": "b.example.com/*",
  //   "zone_name": "example.com"
  // }
}
